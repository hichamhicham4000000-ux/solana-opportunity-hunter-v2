# ============================================================
# Solana Opportunity Hunter
# Environment Configuration
# ============================================================

# ============================================================
# Discord
# ============================================================

# Discord Bot Token
# NEVER commit the real token to GitHub.
DISCORD_BOT_TOKEN=

# Optional Discord Server/Guild ID
DISCORD_GUILD_ID=

# Optional Discord Channel ID for automated opportunity reports
DISCORD_CHANNEL_ID=

# Comma-separated Discord User IDs with administrator privileges
ADMIN_IDS=


# ============================================================
# Solana / Helius
# ============================================================

# Helius API key
# Optional during development, but required for the full
# on-chain intelligence feature set.
HELIUS_API_KEY=

# Solana RPC fallback
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com


# ============================================================
# Database
# ============================================================

DATABASE_URL=sqlite+aiosqlite:///rugscore.db


# ============================================================
# Cache
# ============================================================

CACHE_TTL_SECONDS=60


# ============================================================
# Analysis
# ============================================================

ANALYSIS_TIMEOUT_SECONDS=20
MAX_CONCURRENT_ANALYSES=20


# ============================================================
# Opportunity Hunter
# ============================================================

# Maximum number of candidate tokens considered per discovery cycle.
MAX_DISCOVERY_TOKENS=100

# Minimum score required before a token enters the opportunity
# ranking layer.
OPPORTUNITY_MIN_SCORE=60


# ============================================================
# Runtime
# ============================================================

LOG_LEVEL=INFO
